{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/a-propos/index.html",
        "http://localhost/mentions-legales/index.html",
        "http://localhost/loi-montagne/index.html",
        "http://localhost/voyants/moteur/index.html",
        "http://localhost/voyants/huile/index.html",
        "http://localhost/codes-defaut/p0087/index.html",
        "http://localhost/voyants/fap/index.html",
        "http://localhost/voyants/pression-pneus/index.html",
        "http://localhost/pression-des-pneus/index.html",
        "http://localhost/voyants/index.html",
        "http://localhost/voyants/airbag/index.html",
        "http://localhost/voyants/abs-esp/index.html",
        "http://localhost/voyants/batterie/index.html",
        "http://localhost/voyants/direction/index.html",
        "http://localhost/voyants/adblue/index.html",
        "http://localhost/voyants/prechauffage/index.html",
        "http://localhost/codes-defaut/p0420/index.html",
        "http://localhost/codes-defaut/p0299/index.html",
        "http://localhost/voyants/frein/index.html",
        "http://localhost/voiture-ne-demarre-pas/index.html",
        "http://localhost/moteur-puretech/index.html",
        "http://localhost/batterie-voiture/index.html",
        "http://localhost/batterie-voiture/recharger/index.html",
        "http://localhost/batterie-voiture/changer/index.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "aggregationMethod": "median-run",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "document-title": ["error", { "minScore": 1 }],
        "meta-description": ["error", { "minScore": 1 }],
        "html-has-lang": ["error", { "minScore": 1 }],
        "viewport": ["error", { "minScore": 1 }],
        "link-text": ["error", { "minScore": 1 }],
        "crawlable-anchors": ["error", { "minScore": 1 }],
        "robots-txt": ["error", { "minScore": 1 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
