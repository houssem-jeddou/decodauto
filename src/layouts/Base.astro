---
import { getCollection, getEntry } from 'astro:content';
// Feuille de style de la page seule, selon son format (demande de changement n° 30, lot F1 ; travaux/etape-13/f1/conception.md,
// §2) : texte traité et minifié par Vite (?inline), posé en ligne ; jamais les deux feuilles sur une même page.
import cssFormat1 from '../styles/site.css?inline';
import cssFormat2 from '../styles/charte-b.css?inline';
import type { FormatPage } from '../schemas/pages.ts';
import { PAGE_CONFIDENTIALITE } from '../lib/charte.ts';
import { estIndexable } from '../lib/indexation.ts';
import { bandeau, pied } from '../lib/gabarit.ts';
import { liensFavicon } from '../lib/marque.ts';

interface Props {
  titre: string;
  description: string;
  /** Seule la page 404 n'a pas de canonical. Toute autre page porte la sienne, calculée depuis son adresse. */
  sansCanonical?: boolean;
  /** Scripts JSON-LD de la page (src/lib/donnees-structurees.ts, livrable 7.5a) : déjà échappés, générés depuis la page. */
  donneesStructurees?: readonly string[];
  /** Format de lecture de la page (1 par défaut) : feuille de style, en-tête et pied de page suivent. */
  format?: FormatPage;
}

const { titre, description, sansCanonical = false, donneesStructurees = [], format = 1 } = Astro.props;
const feuille = `<style>${format === 2 ? cssFormat2 : cssFormat1}</style>`;
const indexable = estIndexable();
// Canonical : l'adresse de la page elle-même, absolue (contrôles CANONICAL-*). Jamais saisie à la main.
const canonical = sansCanonical ? undefined : new URL(Astro.url.pathname, Astro.site).href;
// Composants communs à toutes les pages (livrable 6.3, src/lib/gabarit.ts) : nom du site et mention en tête avant le
// H1, lien de signalement en pied de page (contrôles MENTION-IA-* et SIGNALER-ERREUR-ABSENT).
const haut = bandeau();
// Lien vers la politique de confidentialité : dès que sa page est construite, sur toutes les pages, à son adresse du plan.
const pageConfidentialite = (await getCollection('socle')).some((page) => (page.data as { id: string }).id === PAGE_CONFIDENTIALITE);
const adresseConfidentialite = pageConfidentialite ? (await getEntry('plan-du-site', PAGE_CONFIDENTIALITE))?.data.adresse : undefined;
// Sur la page 404, l'adresse demandée n'est pas connue du site statique : le lecteur la complète dans son courriel.
const bas = pied(sansCanonical ? undefined : Astro.url.pathname, adresseConfidentialite);
---

<!doctype html>
<html lang="fr" data-format={String(format)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <Fragment set:html={feuille} />
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <Fragment set:html={liensFavicon()} />
    {donneesStructurees.length > 0 && <Fragment set:html={donneesStructurees.join('')} />}
  </head>
  <body>
    <header class="bandeau">
      <Fragment set:html={haut} />
    </header>
    <main>
      <slot />
    </main>
    <footer class="pied">
      <Fragment set:html={bas} />
    </footer>
  </body>
</html>
