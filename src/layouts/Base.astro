---
import { estIndexable } from '../lib/indexation.ts';

interface Props {
  titre: string;
  description: string;
  canonical?: string;
}

const { titre, description, canonical } = Astro.props;
const indexable = estIndexable();
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={new URL(canonical, Astro.site).href} />}
    <link rel="icon" href="data:," />
    <style>
      :root {
        color-scheme: light;
        --texte: #1a1d21;
        --fond: #ffffff;
        --accent: #0b5cad;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        line-height: 1.6;
        color: var(--texte);
        background: var(--fond);
      }
      main {
        max-width: 40rem;
        margin: 0 auto;
        padding: 4rem 1rem;
      }
      h1 {
        font-size: 1.75rem;
        line-height: 1.25;
        margin: 0 0 1rem;
      }
      a {
        color: var(--accent);
      }
    </style>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
