---
import { APERCU_IMAGE } from '../lib/site.ts';
import { getCollection, getEntry } from 'astro:content';
import { readFile } from 'node:fs/promises';
import { join } from 'node:path';
import { cwd } from 'node:process';
// Feuille de style de la page seule, selon son format (demande de changement n° 30, lot F1 ; travaux/etape-13/f1/conception.md,
// §2) : texte traité et minifié par Vite (?inline), posé en ligne ; jamais les deux feuilles sur une même page.
import cssFormat1 from '../styles/site.css?inline';
import cssFormat2 from '../styles/charte-b.css?inline';
import type { FormatPage } from '../schemas/pages.ts';
import { PAGE_CONFIDENTIALITE } from '../lib/charte.ts';
import { estIndexable } from '../lib/indexation.ts';
import { bandeau, pied } from '../lib/gabarit.ts';
import { adresseBoutonVoyant, bandeauFormat2, menuFormat2, piedFormat2 } from '../lib/format2.ts';
import { ID_OUTIL_VOYANTS } from '../lib/plan.ts';
import { pagesListees } from '../lib/accueil.ts';
import { PAGE_METHODE } from '../lib/charte.ts';
import type { PageEditoriale, PageSaisie } from '../schemas/pages.ts';
import type { Theme } from '../schemas/listes.ts';
import { demoFormat2Active } from '../../scripts/lib/demo-format2.ts';
// Pictogramme du bouton « Trouver mon voyant » du format 2 (pilote : le voyant moteur), tiré de la base des dessins.
import pictogrammeBouton from '../pictogrammes/moteur.svg?raw';
import { liensFavicon } from '../lib/marque.ts';
import { baliseAdsense, configAdsense } from '../lib/adsense.ts';
import { balisesPartage, type Partage } from '../lib/partage.ts';

interface Props {
  titre: string;
  description: string;
  /** Seule la page 404 n'a pas de canonical. Toute autre page porte la sienne, calculée depuis son adresse. */
  sansCanonical?: boolean;
  /** Scripts JSON-LD de la page (src/lib/donnees-structurees.ts, livrable 7.5a) : déjà échappés, générés depuis la page. */
  donneesStructurees?: readonly string[];
  /** Format de lecture de la page (1 par défaut) : feuille de style, en-tête et pied de page suivent. */
  format?: FormatPage;
  /**
   * Image et type de partage de la page (src/lib/partage.ts, lot U3) : balises Open Graph posées avec l'adresse canonique,
   * le title et la description. Toute page qui a une adresse canonique en a un (contrôles PARTAGE-*).
   */
  partage?: Partage;
}

const { titre, description, sansCanonical = false, donneesStructurees = [], format = 1, partage } = Astro.props;
const feuille = `<style>${format === 2 ? cssFormat2 : cssFormat1}</style>`;
const indexable = estIndexable();
// Balise d'association AdSense (demande de changement n° 38, temps 1) : générée depuis config/adsense.json, une fois par
// page ; vide tant qu'il n'y a pas d'identifiant d'éditeur. Ni script ni cookie (contrôles ADSENSE-*).
const balisePublicite = baliseAdsense(configAdsense());
// Canonical : l'adresse de la page elle-même, absolue (contrôles CANONICAL-*). Jamais saisie à la main.
const canonical = sansCanonical ? undefined : new URL(Astro.url.pathname, Astro.site).href;
// Balises de partage (Open Graph, lot U3 de l'audit UX/UI) : seulement avec une adresse canonique (jamais sur la 404).
const partageHtml = canonical !== undefined && partage !== undefined ? balisesPartage({ titre, description, canonical, partage }) : '';
// Composants communs à toutes les pages (livrable 6.3, src/lib/gabarit.ts) : nom du site et mention en tête avant le
// H1, lien de signalement en pied de page (contrôles MENTION-IA-* et SIGNALER-ERREUR-ABSENT). Format 2 (src/lib/format2.ts) :
// bandeau de la piste B, bouton « Trouver mon voyant » vers la page outil si elle est construite ; la mention en tête ouvre
// la tête de page, dans le contenu de la page (main).
const outilConstruit = format === 2 && (await getCollection('voyant')).some((page) => (page.data as { outil?: boolean }).outil === true);
const adresseOutil = outilConstruit ? (await getEntry('plan-du-site', ID_OUTIL_VOYANTS))?.data.adresse : undefined;
// Menu du site et liens du pied de page (demande de changement n° 40, lot U1 ; format 2) : les pages construites par thème,
// la même liste que l'accueil (pagesListees, depuis le plan et les libellés courts des pages construites) ; la page affichée
// y est marquée (sauf la 404, dont l'adresse n'est pas connue du site statique). Liens du pied : seulement si « à propos »
// est construite.
const editoriales = format === 2 ? (await Promise.all((['voyant', 'code-defaut', 'panne', 'fluide', 'pneus', 'dossier'] as const).map((type) => getCollection(type)))).flat() : [];
const libelles = new Map(editoriales.map((entree) => [(entree.data as PageEditoriale).id, (entree.data as PageEditoriale).libelle_court]));
// Le plan dans l'ordre du fichier (data/plan-du-site.json, qui fait foi), comme l'accueil : la collection ne garde pas cet ordre.
const lignesDuPlan = format === 2 ? (JSON.parse(await readFile(join(cwd(), 'data/plan-du-site.json'), 'utf8')) as { id: string; adresse: string; type: string; theme: Theme }[]) : [];
const plan = new Map(lignesDuPlan.map((ligne) => [ligne.id, ligne]));
const pagesDuMenu = format === 2 ? pagesListees(plan, libelles) : [];
const menu = format === 2 ? menuFormat2({ pages: pagesDuMenu, adressePage: sansCanonical ? undefined : Astro.url.pathname }) : '';
const aPropos = format === 2 ? (await getCollection('socle')).map((entree) => entree.data as PageSaisie<'socle'>).find((page) => page.id === PAGE_METHODE) : undefined;
const adresseAPropos = aPropos !== undefined ? plan.get(PAGE_METHODE)?.adresse : undefined;
const themesDuMenu = [...new Set(pagesDuMenu.map((p) => p.theme))].filter((t): t is Exclude<Theme, 'socle'> => t !== 'socle');
const navigationPied = aPropos !== undefined && adresseAPropos !== undefined ? { aPropos: adresseAPropos, libelleAPropos: aPropos.libelle_court ?? aPropos.title, themes: themesDuMenu } : undefined;
// Sur la page outil elle-même, pas de bouton « Trouver mon voyant » (revue de F1.3a) ; ni sur la page 404 (sans canonical),
// qui porte le sien sous sa phrase : un seul bouton par page (revue de F1.3b).
const haut = format === 2 ? bandeauFormat2({ adresseOutil: sansCanonical ? undefined : adresseBoutonVoyant(adresseOutil, Astro.url.pathname), pictogrammeBouton, menu }) : bandeau();
// Lien vers la politique de confidentialité : dès que sa page est construite, sur toutes les pages, à son adresse du plan.
const pageConfidentialite = (await getCollection('socle')).some((page) => (page.data as { id: string }).id === PAGE_CONFIDENTIALITE);
const adresseConfidentialite = pageConfidentialite ? (await getEntry('plan-du-site', PAGE_CONFIDENTIALITE))?.data.adresse : undefined;
// Sur la page 404, l'adresse demandée n'est pas connue du site statique : le lecteur la complète dans son courriel.
const bas = format === 2 ? piedFormat2(sansCanonical ? undefined : Astro.url.pathname, adresseConfidentialite, navigationPied) : pied(sansCanonical ? undefined : Astro.url.pathname, adresseConfidentialite);
---

<!doctype html>
<html lang="fr" data-format={String(format)} data-demo-format2={demoFormat2Active(process.env) ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titre}</title>
    <Fragment set:html={feuille} />
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex" />}
    {indexable && canonical && <meta name="robots" content={APERCU_IMAGE} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {partageHtml !== '' && <Fragment set:html={partageHtml} />}
    <Fragment set:html={liensFavicon()} />
    {balisePublicite !== '' && <Fragment set:html={balisePublicite} />}
    {donneesStructurees.length > 0 && <Fragment set:html={donneesStructurees.join('')} />}
  </head>
  <body>
    <header class="bandeau">
      <Fragment set:html={haut} />
    </header>
    <main data-adresse-imprimee={canonical || undefined}>
      <slot />
    </main>
    <footer class="pied">
      <Fragment set:html={bas} />
    </footer>
  </body>
</html>
