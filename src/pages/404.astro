---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import type { PageSaisie } from '../schemas/pages.ts';
// La page 404 suit le format de l'accueil (demande de changement n° 30, lot F1 ; travaux/etape-13/f1/conception.md, §1).
const format = (await getCollection('socle')).map((entree) => entree.data as PageSaisie<'socle'>).find((page) => page.id === 'accueil')?.format ?? 1;
// Format 2 de la page 404 : à dessiner d'abord (lot F1, F1.3). La démonstration du format 2 (DEMO_FORMAT2=1) ne change que la
// page d'accueil en mémoire : la 404 y reste au format 1.
if (format === 2) throw new Error("page 404 : le format 2 n'est pas encore livré (lot F1, F1.3 : à dessiner d'abord)");
---

<Base
  titre="Page introuvable : decodauto.com"
  description="Cette page n'existe pas (ou plus). Revenez à l'accueil de decodauto.com."
  sansCanonical
  format={format}
>
  <h1>Cette page est introuvable</h1>
  <p>L’adresse demandée n’existe pas, ou le site n’est pas encore en ligne.</p>
  <p>Vous pouvez&nbsp;:</p>
  <ul>
    <li>vérifier l’adresse saisie (elle se termine par une barre oblique&nbsp;: <code>/</code>)&nbsp;;</li>
    <li><a href="/">revenir à l’accueil de decodauto.com</a>.</li>
  </ul>
</Base>
